<?xml version="1.0" encoding="UTF-8"?>
<!-- Daily Short at 07:00 local. Install with scripts/install-launchd.sh -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.quizbot.short</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__REPO__/scripts/run.sh</string><string>short</string></array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__REPO__/state/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__REPO__/state/launchd.err.log</string>
  <key>Nice</key><integer>10</integer>
</dict>
</plist>
