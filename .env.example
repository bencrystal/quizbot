# Copy to .env — loaded automatically by quizbot (no shell profile needed for launchd/cron).
# Pick ONE TTS provider:
OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# QUIZBOT_TTS_VOICE=            # ElevenLabs voice id, OpenAI voice name, or piper .onnx path

# Only if planner: claude
ANTHROPIC_API_KEY=

# Any settings.yaml key can be overridden here:
# QUIZBOT_TTS_PROVIDER=openai
# QUIZBOT_PLANNER=claude
# QUIZBOT_UPLOAD=true
# QUIZBOT_YOUTUBE_PRIVACY=public
# QUIZBOT_SCHEDULE_HOURS_AHEAD=12
# QUIZBOT_NOTIFY_WEBHOOK=https://hooks.slack.com/services/...
